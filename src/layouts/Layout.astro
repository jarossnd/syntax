---
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import Icon from '../components/Icon.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { services } from '../data/services';
import { business } from '../data/business';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const clientPortalUrl = 'https://portal.syntax.dev';
const links = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/get-help/', label: 'Get help' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
if (!Astro.site) {
  throw new Error('Configure the production site URL before generating SEO metadata.');
}
const canonicalUrl = new URL(current === '/' ? '/' : `${current}/`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl.href} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Syntax" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl.href} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <Wordmark />
      <nav class="desktop-nav" aria-label="Main navigation">
        {links.map(({ href, label }) => (
          <a href={href} aria-current={current === (href.replace(/\/$/, '') || '/') ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a class="header-cta" href={clientPortalUrl}>Client Portal <Icon name="arrow" size={17} /></a>
      <details class="mobile-menu">
        <summary>Menu <Icon name="plus" size={19} /></summary>
        <nav aria-label="Mobile navigation">
          {links.map(({ href, label }) => (
            <a href={href} aria-current={current === (href.replace(/\/$/, '') || '/') ? 'page' : undefined}>{label}<Icon name="arrow" size={18} /></a>
          ))}
          <a href={clientPortalUrl}>Client Portal <Icon name="arrow" size={18} /></a>
        </nav>
      </details>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-top">
        <div>
          <Wordmark footer />
          <p>Technology, with purpose.<br />On-site: {business.serviceAreas.join(' and ')}.<br />Remote partnerships available.</p>
          <p><a href={`mailto:${business.email}`}>{business.email}</a><br />{business.hours}.</p>
        </div>
        <div class="footer-links">
          <nav aria-label="Footer navigation">
            <span class="eyebrow">EXPLORE</span>
            <a href="/">Home</a>
            <a href="/services/">Services</a>
            <a href="/get-help/">Get help</a>
            <a href="/contact/">Contact us</a>
            <a href="https://www.facebook.com/synatxinc">Facebook</a>
          </nav>
          <nav aria-label="Service navigation">
            <span class="eyebrow">WHAT WE DO</span>
            {services.map(service => <a href={`/services/${service.id}/`}>{service.title}</a>)}
          </nav>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Syntax Inc. All rights reserved.</span>
        <AnalyticsConsent />
        <span class="footer-signoff"><span class="square"></span> GOOD PEOPLE. GOOD TECHNOLOGY.</span>
      </div>
    </footer>
  </body>
</html>
