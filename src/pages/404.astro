---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page Not Found — Syntax" description="This page isn't here. Find your way back to Syntax for managed IT, consulting, and web services.">
  <section class="page-hero container not-found">
    <p class="eyebrow"><span class="square"></span> ERROR / 404</p>
    <h1>A little off track<span class="accent">.</span></h1>
    <p>That page isn’t here. Let’s get you moving forward again.</p>
    <a class="button button-dark" href="/">Back to home <Icon name="arrow" size={19} /></a>
  </section>
</Layout>
