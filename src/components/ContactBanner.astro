---
import Icon from './Icon.astro';
---
<section class="contact-banner container" aria-labelledby="next-step">
  <div>
    <p class="eyebrow"><span class="square"></span> YOUR NEXT CHAPTER</p>
    <h2 id="next-step">Let’s make IT<br />work for you.</h2>
  </div>
  <div class="contact-banner-action">
    <p>A better website. A smarter setup.<br />A partner who gets the bigger picture.</p>
    <a class="button button-dark" href="/contact/">Let’s talk <Icon name="arrow" size={19} /></a>
  </div>
</section>
